{
  "name": "educational-plan",
  "version": "0.1.0",
  "description": "Система учебного плана и расписания медицинского колледжа",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.solver.json --noEmit",
    "lint": "eslint .",
    "test": "node scripts/electron-node.mjs ./node_modules/vitest/vitest.mjs run",
    "test:solver": "node scripts/electron-node.mjs ./node_modules/vitest/vitest.mjs run tests/solver",
    "test:watch": "node scripts/electron-node.mjs ./node_modules/vitest/vitest.mjs",
    "bench:solver": "node scripts/electron-node.mjs ./node_modules/tsx/dist/cli.mjs tests/solver/bench.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/electron-node.mjs ./node_modules/tsx/dist/cli.mjs scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed:demo": "node scripts/electron-node.mjs ./node_modules/tsx/dist/cli.mjs scripts/seed-demo.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "build": "npm run typecheck && electron-vite build",
    "build:mac": "npm run build && electron-builder --mac --dir",
    "build:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "electron": "44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
